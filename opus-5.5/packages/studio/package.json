{
  "name": "@opusdb/studio",
  "version": "0.1.0",
  "private": true,
  "description": "OpusDB Studio: SQL editor, query plans, B+tree lab, storage inspector and benchmarks in the browser",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-stats.ts",
